# Copy to .env and fill in your keys. Never commit .env.

# OpenRouter - TTS/LLM engines configured with api_key_env defaulting to this
# (used by dub_agent.py)
OPENROUTER_API_KEY=your_key_here

# Groq - speaker identification (speaker_id_groq.py, configure_voices.py)
GROQ_API_KEY=your_key_here

# --- Optional tuning variables (defaults are fine; uncomment to change) ---
# Video encode CRF for the final mux
# YKDUB_VIDEO_CRF=20
# Resume synthesis instead of redoing a partial episode
# YKDUB_RESUME_SYNTH=1
# Extra vocal polish pass during mixing
# YKDUB_VOCAL_POLISH=1
